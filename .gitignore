# ==============================================================================
# GITIGNORE — PROYECTO LA LUPA NEWS (ISO/IEC 27001:2022 & NOMACK STUDIO v5.0.0)
# ==============================================================================

# OS & System Files
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# Editors & IDEs
.vscode/
.idea/
*.swp
*~

# Temporary, Cache & Log files
*.tmp
*.bak
*.log
__pycache__/
*.pyc
*.pyo

# Antigravity Scratch & Temporary Artifacts
scratch/
artifacts/
.gemini/

# SQLite WAL / Shared Memory Sidecars (keep canonical knowledge/project_memory.sqlite tracked)
*.sqlite-wal
*.sqlite-shm

# ==============================================================================
# SEGURIDAD, SECRETOS Y PRIVACIDAD (ISO/IEC 27001:2022 A.8.12 / LEY 1581/2012)
# ==============================================================================
.secrets/
*.pem
*.key
*.cert
*.crt
.env
.env.*
!.env.example
secrets.json
credentials.json
auth.json
*.token
*.apikey
*pass*.txt
*password*
wp-config.php

# ==============================================================================
# BACKUPS DE SERVIDOR Y DUMPS DE BASE DE DATOS (PROHIBIDOS EN GIT)
# ==============================================================================
backups/
05_Servidor_Backups/
*.sql
*.sql.gz
*.tar
*.tar.gz
*.zip
*.rar
*.7z

# ==============================================================================
# BINARIOS MULTIMEDIA Y FUENTES EDITABLES PESADAS (>10 MB / DISEÑO CRUDO)
# ==============================================================================
*.mp4
*.mov
*.avi
*.mkv
*.psd
*.ai
*.indd

# Entornos y dependencias
node_modules/
.venv/
venv/

# Documentación vendor de terceros (ThemeForest JNews)
web/themes/Documentation/
